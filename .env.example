# Server
PORT=4001
HOST=127.0.0.1
ENV=staging
APP_BASE_DOMAIN=centrachannel.my.id

# Deployment
IMAGE_NAME=ghcr.io/handev-id/centrachannel-backend-code
IMAGE_TAG=local

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=centrachannel_staging
DB_SSL_MODE=disable
DB_URL=postgres://postgres:change-me@127.0.0.1:5432/centrachannel_staging?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# JWT
JWT_SECRET=change-me
JWT_EXPIRY=24h

# CORS
CORS_ALLOWED_ORIGINS=https://centrachannel.my.id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Storage
STORAGE_URL=https://storage.solodevs.my.id
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760
STORAGE_SECRET_KEY=change-me

# Evolution API
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=change-me
WEBHOOK_BASE_URL=https://centrachannel.my.id

# Meta Webhook
META_WEBHOOK_SECRET=
META_APP_SECRET=

# Logger
LOG_LEVEL=info
LOG_FORMAT=json
