{
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
    "tenant_id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
    "conversation_id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
    "sender_id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
    "sender_type": { "type": "string", "enum": ["contact", "user", "ai"], "example": "contact" },
    "text": { "type": "string", "example": "Hello, I need help" },
    "attachment": { "type": "object", "example": { "name": "file.pdf", "url": "https://cdn.example.com/file.pdf", "type": "application/pdf" } },
    "status": { "type": "string", "enum": ["sent", "delivered", "read", "unread", "failed"], "example": "sent" },
    "webhook_message_id": { "type": "string", "example": "wamid.123456789" },
    "webhook_message_reply_id": { "type": "string", "example": "wamid.987654321" },
    "created_at": { "type": "string", "format": "date-time", "example": "2025-07-29T10:00:00.000Z" },
    "updated_at": { "type": "string", "format": "date-time", "example": "2025-07-29T10:00:00.000Z" },
    "sender": { "type": "object", "properties": {
      "id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
      "first_name": { "type": "string", "example": "Jane" },
      "last_name": { "type": "string", "example": "Smith" },
      "avatar": { "type": "object" }
    } }
  }
}
