{
  "type": "object",
  "properties": {
    "id": { "type": "integer", "example": 1 },
    "tenant_id": { "type": "integer", "example": 1 },
    "name": { "type": "string", "example": "Welcome Campaign" },
    "type": { "type": "string", "example": "broadcast" },
    "description": { "type": "string", "example": "Welcome message for new users" },
    "message_template": { "type": "string", "example": "Hello {{name}}, welcome to our service!" },
    "channel_id": { "type": "integer", "example": 1 },
    "status": { "type": "string", "enum": ["draft", "scheduled", "sending", "sent", "failed"], "example": "draft" },
    "sending_option": { "type": "object", "example": { "delay_seconds": 5 } },
    "stats": { "type": "object", "example": { "sent": 45, "failed": 2, "total": 50 } },
    "scheduled_at": { "type": "string", "format": "date-time", "example": "2025-08-01T10:00:00.000Z" },
    "sent_count": { "type": "integer", "example": 0 },
    "total_count": { "type": "integer", "example": 100 },
    "agent_id": { "type": "integer", "example": 1 },
    "sender_id": { "type": "integer", "example": 1 },
    "recipient_list_id": { "type": "integer", "example": 1 },
    "template_id": { "type": "integer", "example": 1 },
    "created_by": { "type": "integer", "example": 1 },
    "created_at": { "type": "string", "format": "date-time", "example": "2025-07-29T10:00:00.000Z" },
    "updated_at": { "type": "string", "format": "date-time", "example": "2025-07-29T12:00:00.000Z" }
  }
}
