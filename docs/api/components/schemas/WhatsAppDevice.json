{
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
    "tenant_id": { "type": "string", "format": "uuid", "example": "00000000-0000-4000-8000-000000000001" },
    "name": { "type": "string", "example": "Sales Phone" },
    "country_code": { "type": "string", "example": "62" },
    "phone": { "type": "string", "example": "6281234567890" },
    "whatsapp_id": { "type": "string", "example": "device-abc-123" },
    "status": { "type": "string", "enum": ["connected", "disconnected", "connecting", "scanning"], "example": "connected" },
    "deleted_at": { "type": "string", "format": "date-time", "example": null },
    "created_at": { "type": "string", "format": "date-time", "example": "2025-07-29T10:00:00.000Z" },
    "updated_at": { "type": "string", "format": "date-time", "example": "2025-07-29T12:00:00.000Z" }
  }
}
