    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["Observability"],
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "/docs/api/components/schemas/Message.json"
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "get": {
        "summary": "Ping endpoint",
        "tags": ["Observability"],
        "responses": {
          "200": {
            "description": "Pong response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "pong"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Version info",
        "tags": ["Observability"],
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "version": { "type": "string", "example": "1.0.0" },
                        "app": { "type": "string", "example": "CentraChannel API" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/webhook/evolution": {
      "post": {
        "summary": "Evolution webhook handler",
        "tags": ["Webhook"],
        "responses": {
          "200": { "description": "Webhook received" }
        }
      }
    },
    "/webhook/meta": {
      "get": {
        "summary": "Meta webhook verification",
        "tags": ["Webhook"],
        "responses": {
          "200": { "description": "Verification response" }
        }
      },
      "post": {
        "summary": "Meta webhook handler",
        "tags": ["Webhook"],
        "responses": {
          "200": { "description": "Webhook received" }
        }
      }
    },
    "/ws": {
      "get": {
        "summary": "WebSocket connection",
        "tags": ["WebSocket"],
        "responses": {
          "101": { "description": "WebSocket protocol upgrade" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
