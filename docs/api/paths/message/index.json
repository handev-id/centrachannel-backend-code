{
  "get": {
    "summary": "List messages in a conversation",
    "tags": ["Message"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "conversationId", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Conversation ID" },
      { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number (offset pagination)" },
      { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 }, "description": "Results per page" },
      { "name": "last_id", "in": "query", "schema": { "type": "integer" }, "description": "Cursor: last message ID from previous page. When provided, switches to cursor pagination." }
    ],
    "responses": {
      "200": {
        "description": "List of messages. Uses offset or cursor pagination based on query params.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": { "$ref": "../../components/schemas/Meta.json" },
                "data": {
                  "type": "object",
                  "properties": {
                    "meta_pagination": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "total": { "type": "integer" },
                            "per_page": { "type": "integer" },
                            "current_page": { "type": "integer" },
                            "last_page": { "type": "integer" },
                            "from": { "type": "integer" },
                            "to": { "type": "integer" }
                          },
                          "description": "Offset pagination meta (when page param used)"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "last_id": { "type": "integer" },
                            "has_more": { "type": "boolean" }
                          },
                          "description": "Cursor pagination meta (when last_id param provided)"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "../../components/schemas/MessageModel.json" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Send a message in a conversation",
    "tags": ["Message"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "conversationId", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Conversation ID" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["sender_id", "sender_type"],
            "properties": {
              "text": { "type": "string", "example": "Hello, how can I help you?" },
              "attachment": { "type": "object" },
              "sender_id": { "type": "integer", "example": 1 },
              "sender_type": { "type": "string", "enum": ["contact", "user", "ai"], "example": "user" }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Message sent",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/MessageModel.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  }
}
