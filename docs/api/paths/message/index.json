{
  "get": {
    "summary": "List messages in a conversation",
    "tags": [
      "Message"
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "conversationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Conversation ID"
      },
      {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 50
        },
        "description": "Results per page"
      },
      {
        "name": "last_id",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Cursor: oldest message ID returned by the previous page."
      }
    ],
    "responses": {
      "200": {
        "description": "Cursor pagination only. Messages in each page are chronological.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "last_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  }
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "../../components/schemas/MessageModel.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Send a message in a conversation",
    "tags": [
      "Message"
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "conversationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Conversation ID"
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "example": "Hello, how can I help you?"
              },
              "attachment": {
                "allOf": [
                  {
                    "$ref": "../../components/schemas/MessageAttachment.json"
                  },
                  {
                    "required": [
                      "type",
                      "url",
                      "mimetype",
                      "size"
                    ]
                  }
                ]
              },
              "sender_id": {
                "type": "string",
                "format": "uuid",
                "example": "00000000-0000-4000-8000-000000000001"
              },
              "sender_type": {
                "type": "string",
                "enum": [
                  "contact",
                  "user",
                  "ai"
                ],
                "example": "user"
              }
            },
            "description": "Requires nonempty text or one attachment. Authenticated user determines sender_id and sender_type. Upload the file first; use data.url and metadata. text is the image/video/document caption when an attachment is present. Audio does not support captions; send text separately."
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Message saved as pending; provider acceptance updates it to sent.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": {
                  "type": "object"
                },
                "data": {
                  "$ref": "../../components/schemas/MessageModel.json"
                }
              }
            }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/ValidationError.json"
            }
          }
        }
      },
      "400": {
        "description": "Empty content or invalid attachment metadata."
      }
    }
  }
}
