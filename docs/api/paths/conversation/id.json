{
  "get": {
    "summary": "Get Conversation by ID",
    "tags": ["Conversation"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Conversation ID" }
    ],
    "responses": {
      "200": {
        "description": "Conversation details",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Conversation.json" }
          }
        }
      },
      "404": {
        "description": "Conversation not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  }
}
