{
  "put": {
    "summary": "Update Note",
    "tags": ["Note"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Note ID" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "text": { "type": "string", "example": "Updated note content" },
              "date": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Note updated",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Note.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  },
  "delete": {
    "summary": "Delete Note",
    "tags": ["Note"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Note ID" }
    ],
    "responses": {
      "200": {
        "description": "Note deleted",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Message.json" }
          }
        }
      },
      "404": {
        "description": "Note not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  }
}
