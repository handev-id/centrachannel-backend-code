{
  "get": {
    "summary": "List Campaigns",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
      { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Results per page" },
      { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search keyword" }
    ],
    "responses": {
      "200": {
        "description": "Paginated list of campaigns",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": { "$ref": "../../components/schemas/Meta.json" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "../../components/schemas/Campaign.json" }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Create Campaign",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["name", "message_template", "channel_id"],
            "properties": {
              "name": { "type": "string", "example": "Welcome Campaign" },
              "type": { "type": "string", "example": "broadcast" },
              "description": { "type": "string", "example": "Welcome message for new users" },
              "message_template": { "type": "string", "example": "Hello {{name}}, welcome!" },
              "channel_id": { "type": "integer", "example": 1 },
              "sending_option": { "type": "object" },
              "scheduled_at": { "type": "string", "format": "date-time" },
              "recipient_list_id": { "type": "integer", "example": 1 },
              "template_id": { "type": "integer", "example": 1 }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Campaign created",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Campaign.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  }
}
