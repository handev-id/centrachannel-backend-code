{
  "get": {
    "summary": "List Campaign Templates",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
      { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Results per page" }
    ],
    "responses": {
      "200": {
        "description": "Paginated list of templates",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": { "$ref": "../../components/schemas/Meta.json" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "../../components/schemas/CampaignTemplate.json" }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Create Campaign Template",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["name", "content"],
            "properties": {
              "name": { "type": "string", "example": "Welcome Template" },
              "type": { "type": "string" },
              "template_type": { "type": "string" },
              "category": { "type": "string" },
              "language": { "type": "string", "example": "en" },
              "content": { "type": "object" },
              "variables": { "type": "object" },
              "quality": { "type": "string" },
              "account_id": { "type": "integer" }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Template created",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/CampaignTemplate.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  }
}
