{
  "get": {
    "summary": "List Recipient Lists",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
      { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Results per page" }
    ],
    "responses": {
      "200": {
        "description": "Paginated list of recipient lists",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": { "$ref": "../../components/schemas/Meta.json" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "../../components/schemas/CampaignRecipientList.json" }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Create Recipient List",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "example": "Newsletter Subscribers" },
              "source": { "type": "string", "example": "manual" },
              "channel_id": { "type": "integer", "example": 1 }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Recipient list created",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/CampaignRecipientList.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  }
}
