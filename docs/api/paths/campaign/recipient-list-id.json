{
  "get": {
    "summary": "Get Recipient List by ID",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Recipient List ID" }
    ],
    "responses": {
      "200": {
        "description": "Recipient list details",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/CampaignRecipientList.json" }
          }
        }
      },
      "404": {
        "description": "Recipient list not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  },
  "put": {
    "summary": "Update Recipient List",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Recipient List ID" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "source": { "type": "string" },
              "status": { "type": "string" },
              "channel_id": { "type": "integer" }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Recipient list updated",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/CampaignRecipientList.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  },
  "delete": {
    "summary": "Delete Recipient List",
    "tags": ["Campaign"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Recipient List ID" }
    ],
    "responses": {
      "200": {
        "description": "Recipient list deleted",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Message.json" }
          }
        }
      },
      "404": {
        "description": "Recipient list not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  }
}
