{
  "get": {
    "summary": "List current tenant domains",
    "tags": [
      "Domain"
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "description": "Admin/super-admin only. Tenant ID comes from authenticated request context. All active hostnames access the same tenant without redirects.",
    "responses": {
      "400": {
        "description": "Invalid payload or UUID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "403": {
        "description": "Admin or super-admin required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "404": {
        "description": "Domain not found in current tenant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "422": {
        "description": "Request DTO validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "500": {
        "description": "Operation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "200": {
        "description": "Domains sorted default first, then name",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": {
                  "$ref": "../../components/schemas/Meta.json"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "../../components/schemas/Domain.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Create tenant domain",
    "tags": [
      "Domain"
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "description": "Admin/super-admin only. Tenant ID comes from authenticated request context. All active hostnames access the same tenant without redirects.",
    "responses": {
      "400": {
        "description": "Invalid request, duplicate domain, domain not found, or default domain protection",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "403": {
        "description": "Admin or super-admin required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "404": {
        "description": "Domain not found in current tenant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "422": {
        "description": "Request DTO validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "500": {
        "description": "Operation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/Error.json"
            }
          }
        }
      },
      "201": {
        "description": "Domain created",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": {
                  "$ref": "../../components/schemas/Meta.json"
                },
                "data": {
                  "$ref": "../../components/schemas/Domain.json"
                }
              }
            }
          }
        }
      }
    },
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 254,
                "example": "crm.company.com",
                "description": "Complete ASCII hostname; normalized to lowercase and trailing dot removed. No scheme, port, path, wildcard or IP."
              },
              "is_default": {
                "type": "boolean",
                "description": "Exactly one active default per tenant.",
                "default": false
              },
              "is_active": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    }
  }
}
