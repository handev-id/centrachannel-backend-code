{
  "get": {
    "summary": "Check if token is valid",
    "tags": ["Auth"],
    "security": [{ "bearerAuth": [] }],
    "responses": {
      "200": {
        "description": "Token is valid",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "valid": { "type": "boolean", "example": true },
                "user": { "$ref": "../../components/schemas/User.json" }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  }
}
