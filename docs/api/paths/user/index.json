{
  "get": {
    "summary": "List Users",
    "tags": ["User"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
      { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Results per page" },
      { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search keyword" },
      { "name": "role_id", "in": "query", "schema": { "type": "integer" }, "description": "Filter by role ID" },
      { "name": "sort_by", "in": "query", "schema": { "type": "string" }, "description": "Sort field" }
    ],
    "responses": {
      "200": {
        "description": "Paginated list of users",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": { "$ref": "../../components/schemas/Meta.json" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "../../components/schemas/User.json" }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Create User",
    "tags": ["User"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["first_name", "username", "email", "roles"],
            "properties": {
              "first_name": { "type": "string", "example": "Jane" },
              "last_name": { "type": "string", "example": "Doe" },
              "username": { "type": "string", "example": "janedoe" },
              "email": { "type": "string", "format": "email", "example": "jane@example.com" },
              "phone": { "type": "string", "example": "6281234567890" },
              "password": { "type": "string", "example": "password123" },
              "avatar": { "type": "object" },
              "roles": {
                "type": "array",
                "items": { "type": "integer" },
                "example": [2, 3]
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "User created successfully",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/User.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  }
}
