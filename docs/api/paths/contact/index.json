{
  "get": {
    "summary": "List Contacts",
    "tags": ["Contact"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
      { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Results per page" },
      { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search keyword" },
      { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "Filter by contact status (individual/institution)" },
      { "name": "channel_id", "in": "query", "schema": { "type": "integer" }, "description": "Filter by channel ID" },
      { "name": "channel_type", "in": "query", "schema": { "type": "string" }, "description": "Filter by channel type (facebook, instagram, whatsapp_business, whatsapp)" },
      { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Filter by category" },
      { "name": "country", "in": "query", "schema": { "type": "string" }, "description": "Filter by country" },
      { "name": "province", "in": "query", "schema": { "type": "string" }, "description": "Filter by province_of_origin" },
      { "name": "agent_id", "in": "query", "schema": { "type": "integer" }, "description": "Filter by assigned agent ID" },
      { "name": "is_merged", "in": "query", "schema": { "type": "string", "enum": ["true", "false"] }, "description": "Filter merged contacts" },
      { "name": "has_conversation", "in": "query", "schema": { "type": "string", "enum": ["true", "false"] }, "description": "Filter contacts with/without conversations" },
      { "name": "last_activity_from", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Filter by last activity start date (ISO 8601)" },
      { "name": "last_activity_to", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Filter by last activity end date (ISO 8601)" },
      { "name": "sort_by", "in": "query", "schema": { "type": "string" }, "description": "Sort field. Prefix with - for DESC (e.g. -created_at). Supported: first_name, last_name, email, phone, created_at, updated_at" }
    ],
    "responses": {
      "200": {
        "description": "Paginated list of contacts",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "meta": { "$ref": "../../components/schemas/Meta.json" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "../../components/schemas/Contact.json" }
                }
              }
            }
          }
        }
      }
    }
  },
  "post": {
    "summary": "Create Contact",
    "tags": ["Contact"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["first_name"],
            "properties": {
              "first_name": { "type": "string", "example": "Jane" },
              "last_name": { "type": "string", "example": "Smith" },
              "username": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "phone": { "type": "string" },
              "avatar": { "type": "object" },
              "country": { "type": "string" },
              "bio": { "type": "string" },
              "occupation": { "type": "string" },
              "category": { "type": "string" },
              "category_description": { "type": "string" },
              "gender": { "type": "string" },
              "date_of_birth": { "type": "string" },
              "province_of_origin": { "type": "string" },
              "facebook": { "type": "string" },
              "instagram": { "type": "string" },
              "whatsapp": { "type": "string" },
              "x": { "type": "string" },
              "tiktok": { "type": "string" },
              "status": { "type": "string" },
              "institution_name": { "type": "string" }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Contact created",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Contact.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  }
}
