{
  "get": {
    "summary": "Get WhatsApp Device by ID",
    "tags": ["WhatsApp Device"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Device ID" }
    ],
    "responses": {
      "200": {
        "description": "Device details",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/WhatsAppDevice.json" }
          }
        }
      },
      "404": {
        "description": "Device not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  },
  "put": {
    "summary": "Update WhatsApp Device",
    "tags": ["WhatsApp Device"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Device ID" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "country_code": { "type": "string" },
              "phone": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Device updated",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/WhatsAppDevice.json" }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/ValidationError.json" }
          }
        }
      }
    }
  },
  "delete": {
    "summary": "Delete WhatsApp Device",
    "tags": ["WhatsApp Device"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Device ID" }
    ],
    "responses": {
      "200": {
        "description": "Device deleted",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Message.json" }
          }
        }
      },
      "404": {
        "description": "Device not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/Error.json" }
          }
        }
      }
    }
  }
}
